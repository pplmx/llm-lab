root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[*.{md,markdown}]
# Markdown 行尾两个空格是有意义的换行
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[{Justfile,makefile,Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[go.mod]
indent_style = tab
indent_size = 4
